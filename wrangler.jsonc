{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "secondlook",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "secondlook"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secondlook",
      "database_id": "ab08c637-0076-434c-8229-b64ae11ac33d"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "EMAIL_FROM": "SecondLook <beth.t@example.com>",
    "CONTACT_NOTIFY_EMAIL": "julio.cruz@eb-ms.net"
  }
}
